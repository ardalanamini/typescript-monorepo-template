{
  "name": "@typescript-monorepo-org/typescript-monorepo-template",
  "private": true,
  "version": "0.0.0",
  "description": "typescript-monorepo-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/typescript-monorepo-org/typescript-monorepo-template.git"
  },
  "bugs": {
    "url": "https://github.com/typescript-monorepo-org/typescript-monorepo-template/issues"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "lint:fix": "nx run-many -t lint:fix",
    "test": "nx run-many -t test",
    "test:coverage": "nx run-many -t test:coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "is-ci || lefthook install",
    "knip": "knip"
  },
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "is-ci": "4.1.0",
    "knip": "6.35.1",
    "lefthook": "2.1.12",
    "nx": "23.2.1",
    "oxlint": "1.82.0",
    "oxlint-config-noir": "1.0.7",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
